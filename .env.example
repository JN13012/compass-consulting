# Copier en .env (jamais commité) et remplir.

# --- Option A : fournisseur IA cloud (une seule clé, n'importe quel fournisseur) ---
# Le fournisseur est déduit du préfixe du modèle : anthropic/…, openai/…, mistral/…, gemini/…
AI_API_KEY=
AI_MODEL=anthropic/claude-opus-5-5
KB_ROLE=reasoning

# --- Option B : modèle local avec Ollama (gratuit, données qui ne quittent pas la machine) ---
# Voir docs/OLLAMA.md. Décommenter pour utiliser le local :
# KB_ROLE=local
# LOCAL_MODEL=ollama_chat/qwen3.5:9b
OLLAMA_BASE_URL=http://ollama:11434

# Recherche par le sens (embeddings). Changer de modèle impose : python -m app.corpus embed
EMBEDDING_MODEL=ollama/bge-m3

# Divers
ETHERSCAN_API_KEY=
# FRONT_PORT=5180
